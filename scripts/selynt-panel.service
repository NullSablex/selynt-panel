[Unit]
Description=Selynt Panel — restaurar apps após reboot
After=network-online.target directadmin.service lsws.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/directadmin/plugins/selynt_panel/scripts/boot-recover.sh
RemainAfterExit=no
User=root

# The apps this unit starts must outlive it. By default systemd kills the whole
# cgroup once a oneshot service exits, so every app came back up and was killed
# a moment later — the reason nothing survived a reboot. `KillMode=process`
# limits that to the main process, and the apps (already in their own session
# via setsid) keep running.
KillMode=process

[Install]
WantedBy=multi-user.target
