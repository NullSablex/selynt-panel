#!/usr/local/bin/php -n
<?php
declare(strict_types=1);

require_once dirname(__DIR__, 2) . '/lib/common.php';

$input  = selynt_input();
$action = (string)($input['action'] ?? '');

if ($action === 'setup_ols') {
    selynt_require_post();
    $script = SELYNT_PLUGIN_DIR . '/scripts/setup-ols.sh';
    if (!is_executable($script)) {
        selynt_json(['ok' => false, 'error' => 'script_missing', 'message' => selynt_t('errors.script_missing', ['script' => 'setup-ols.sh'])]); exit(0);
    }
    $output = []; $exit_code = 0;
    exec('bash ' . escapeshellarg($script) . ' 2>&1', $output, $exit_code);
    selynt_json([
        'ok'      => $exit_code === 0,
        'output'  => implode("\n", $output),
        'message' => $exit_code !== 0 ? selynt_t('errors.setup_ols_failed', ['exit' => $exit_code]) : null,
    ]); exit(0);
}

if ($action === 'version') {
    selynt_json(selynt_run(['admin', 'version'])); exit(0);
}

if ($action === 'detect_nodes') {
    selynt_json(selynt_run(['admin', 'detect-nodes'])); exit(0);
}

if ($action === 'allowed_versions') {
    $nv_file = SELYNT_PLUGIN_DIR . '/etc/node_versions';
    $versions = [];
    if (file_exists($nv_file)) {
        $lines = file($nv_file);
        if ($lines !== false) {
            foreach ($lines as $line) {
                $parts = preg_split('/\s+/', trim($line), 2);
                if (is_array($parts) && !empty($parts[1])) $versions[] = $parts[1];
            }
        }
    }
    selynt_json(['ok' => true, 'versions' => $versions]); exit(0);
}

if ($action === 'save_node_versions') {
    selynt_require_post();
    $s = trim((string)($input['s'] ?? ''));
    if ($s === '') {
        selynt_json(['ok' => false, 'error' => 'no_selection', 'message' => selynt_t('errors.no_selection')]); exit(0);
    }
    $args = ['admin', 'save-node-versions'];
    foreach (explode('-', $s) as $idx) {
        $args[] = (string)(int)$idx;
    }
    selynt_json(selynt_run($args)); exit(0);
}

if ($action === 'get_locale') {
    selynt_json([
        'ok'      => true,
        'options' => selynt_i18n_options(),
        'global'  => selynt_i18n_global(),
        'active'  => selynt_locale(),
    ]); exit(0);
}

if ($action === 'save_locale') {
    selynt_require_post();
    $locale = trim((string)($input['locale'] ?? ''));
    // Reject anything that isn't a shipped dictionary before spending a fork on
    // the binary. '' is legitimate here — it clears the default.
    if ($locale !== '' && selynt_normalize_locale($locale, selynt_i18n_available()) === null) {
        selynt_json(['ok' => false, 'error' => 'invalid_locale', 'message' => selynt_t('errors.invalid_locale')]);
        exit(0);
    }
    $res = selynt_i18n_set_global($locale);
    if (!($res['ok'] ?? false)) {
        // Coalesce on empty too: the binary reports argument errors on stderr,
        // which reaches us as an empty message that ?? would happily keep.
        if (trim((string)($res['message'] ?? '')) === '') {
            $res['message'] = selynt_t('errors.invalid_locale');
        }
        selynt_json($res); exit(0);
    }
    selynt_json(['ok' => true, 'global' => selynt_i18n_global()]); exit(0);
}

selynt_json(['ok' => false, 'error' => 'unknown_action']);
