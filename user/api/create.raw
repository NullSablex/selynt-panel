#!/usr/local/bin/php -n
<?php
declare(strict_types=1);

require_once dirname(__DIR__, 2) . '/lib/common.php';
selynt_require_post();
$input = selynt_input();
$name    = trim((string)($input['name']  ?? ''));
$type    = trim((string)($input['type']  ?? 'node'));
$cwd     = trim((string)($input['cwd']   ?? ''));
$entry   = trim((string)($input['entry'] ?? ''));
$host    = trim((string)($input['host']  ?? ''));
$env_raw = trim((string)($input['env']   ?? ''));

foreach (['name','type','cwd','entry','host'] as $f) {
    if ($$f === '') {
        selynt_json(['ok'=>false,'error'=>'missing_fields','message'=>selynt_t('errors.missing_field', ['field' => $f])]); exit(0);
    }
}

if (!preg_match('/^[A-Za-z0-9._\-]{1,64}$/', $name)) {
    selynt_json(['ok'=>false,'error'=>'invalid_name','message'=>selynt_t('errors.invalid_name')]); exit(0);
}
if (!in_array($type, ['node', 'rust'], true)) {
    selynt_json(['ok'=>false,'error'=>'invalid_type','message'=>selynt_t('errors.invalid_type')]); exit(0);
}

$node_version = trim((string)($input['node_version'] ?? ''));

$args = ['add', $name, '--type', $type, '--cwd', $cwd, '--entry', $entry, '--host', $host];
if ($type === 'node' && $node_version !== '') {
    $args[] = '--node-version'; $args[] = $node_version;
}
foreach (explode("\n", $env_raw) as $line) {
    $line = trim($line);
    if ($line !== '' && strpos($line, '=') !== false) {
        $args[] = '--env'; $args[] = $line;
    }
}

selynt_json(selynt_run($args));
