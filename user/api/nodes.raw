#!/usr/local/bin/php -n
<?php
declare(strict_types=1);

require_once dirname(__DIR__, 2) . '/lib/common.php';

// Formato do arquivo: "path version" por linha (ex: "/usr/local/bin/node v20.15.1")
$nv_file = SELYNT_PLUGIN_DIR . '/etc/node_versions';
$versions = [];

if (file_exists($nv_file)) {
    $lines = file($nv_file);
    if ($lines !== false) {
        foreach ($lines as $line) {
            $parts = preg_split('/\s+/', trim($line), 2);
            if (!is_array($parts)) continue;
            $path = (string)($parts[0] ?? '');
            $ver  = (string)($parts[1] ?? '');
            if ($path === '' || $path[0] !== '/') continue;
            $label = $ver !== '' ? ltrim($ver, 'v') : basename(dirname($path));
            $versions[] = ['path' => $path, 'version' => $ver, 'label' => $label];
        }
    }
}

// Da mais nova para a mais antiga. O core já grava ordenado, mas o arquivo
// pode ter sido escrito por uma versão anterior, e aqui só se lê o que está
// gravado: sem isto, o painel exibe a ordem da varredura (v25, v20, v22, v24).
usort($versions, static function (array $a, array $b): int {
    $parse = static function (string $v): array {
        $n = array_map('intval', explode('.', ltrim($v, 'v')));
        return [$n[0] ?? 0, $n[1] ?? 0, $n[2] ?? 0];
    };
    return $parse($b['version']) <=> $parse($a['version'])
        ?: strcmp($a['path'], $b['path']);
});

// Se nenhuma versão configurada, oferecer default do PATH
if (empty($versions)) {
    $ver = trim((string)shell_exec('node --version 2>/dev/null'));
    $label = $ver !== ''
        ? ltrim($ver, 'v') . ' (' . selynt_t('create.field.node_default_short') . ')'
        : selynt_t('create.field.node_system_default');
    $versions[] = ['path' => '', 'version' => $ver, 'label' => $label];
}

selynt_json(['ok' => true, 'versions' => $versions]);
