#!/usr/local/bin/php
<?php
declare(strict_types=1);

require_once dirname(__DIR__) . '/lib/common.php';

$bin_ok   = is_executable(SELYNT_BIN);
$username = selynt_username();
$pluginBase = '/CMD_PLUGINS/selynt_panel';
$v = SELYNT_VERSION;

// Domínio selecionado no DA (env ou query string)
$selected = trim((string)getenv('DOMAIN'));
if ($selected === '') {
    $qs = [];
    parse_str((string)getenv('QUERY_STRING'), $qs);
    $selected = trim((string)($qs['domain'] ?? ''));
}

// Chama o binário para listar domínios (filtrado se há seleção)
$domains_result = null;
if ($bin_ok) {
    $args = ['domains'];
    if ($selected !== '') {
        $args[] = '--domain';
        $args[] = $selected;
    }
    $domains_result = selynt_run($args);
}
